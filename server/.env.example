# Copy to server/.env.local; keep both tokens private. Node.js 22+.
LEAFY_DEVICE_URL=http://192.168.1.100
# Copy LEAF_CONTROL_KEY from the board's private settings.hpp:
LEAFY_DEVICE_KEY=replace-with-board-control-key
# Generate a DIFFERENT token: openssl rand -hex 32
LEAFY_API_TOKEN=replace-with-a-random-64-character-token
LEAFY_BIND=127.0.0.1
LEAFY_PORT=8787
LEAFY_STATE_PATH=server/data/commands.json
# For trusted home LAN access ONLY, set BIND=0.0.0.0 and this to true.
LEAFY_ALLOW_LAN_HTTP=false
